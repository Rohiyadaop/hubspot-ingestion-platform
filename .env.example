# Copy to .env and replace both values with high-entropy secrets.
API_KEY=replace-with-a-unique-client-key
HMAC_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_USER=hubspot_service
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=hubspot_ingestion

# Keep mock mode for local development. For production use HUBSPOT_API_MODE=hubspot,
# HUBSPOT_BASE_URL=https://api.hubapi.com, and a private-app access token.
HUBSPOT_API_MODE=mock
HUBSPOT_BASE_URL=http://mock-hubspot:8000
HUBSPOT_ACCESS_TOKEN=